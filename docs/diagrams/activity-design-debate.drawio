        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;● start  ◎ end  ◆ decision&lt;br&gt;&lt;font color=&quot;#6C8EBF&quot;&gt;■&lt;/font&gt; action  &lt;font color=&quot;#82B366&quot;&gt;■&lt;/font&gt; success&lt;br&gt;&lt;font color=&quot;#D6B656&quot;&gt;■&lt;/font&gt; needs user attention&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;■&lt;/font&gt; degraded (no web)&lt;br&gt;[guard] on branches" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
