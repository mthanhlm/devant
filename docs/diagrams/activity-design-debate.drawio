        </mxCell>
        <mxCell id="a_router" value="&lt;b&gt;Route request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;[router: ground + push back]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
