<mxfile host="devant"><diagram name="Design debate flow" id="design-debate-flow"><mxGraphModel dx="900" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0" pageWidth="820" pageHeight="2530"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="30" height="30" as="geometry" /></mxCell><mxCell id="route" value="&lt;b&gt;Route request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;[router: ground + push back]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="170" height="70" as="geometry" /></mxCell><mxCell id="design" value="&lt;b&gt;Draft design&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;[architect: current vs proposed]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="270" width="170" height="70" as="geometry" /></mxCell><mxCell id="debate" value="&lt;b&gt;Re-ground independently&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;[debate: fork, read-only]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="190" height="70" as="geometry" /></mxCell><mxCell id="web" value="Web reachable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="140" height="80" as="geometry" /></mxCell><mxCell id="hypo" value="&lt;b&gt;Tag unverified claims&lt;/b&gt;&lt;br&gt;&lt;font color=&qu