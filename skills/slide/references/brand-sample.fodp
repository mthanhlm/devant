<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:automatic-styles>
  <style:page-layout style:name="PL"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/></style:page-layout>
  <style:style style:name="dpDark" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#1B1A17"/></style:style>
  <style:style style:name="dpPaper" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#FFFFFF"/></style:style>
  <style:style style:name="gText" style:family="graphic"><style:graphic-properties draw:fill="none" draw:stroke="none" draw:shadow="hidden" draw:auto-grow-height="true"/></style:style>
  <style:style style:name="gCardPanel" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#F2F1EE" draw:stroke="none" draw:shadow="hidden"/></style:style>
  <style:style style:name="gCardAccent" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#C4351F" draw:stroke="none" draw:shadow="hidden"/></style:style>
  <style:style style:name="gAccent" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#C4351F" draw:stroke="none" draw:shadow="hidden"/></style:style>
  <style:style style:name="gGrey" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#6E6B64" draw:stroke="none" draw:shadow="hidden"/></style:style>
  <style:style style:name="gHair" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#E4E2DC" draw:stroke="none" draw:shadow="hidden"/></style:style>
  <style:style style:name="pH1w" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="40pt" fo:font-weight="bold" fo:color="#FFFFFF"/></style:style>
  <style:style style:name="pSubL" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="18pt" fo:color="#9C9A93"/></style:style>
  <style:style style:name="pEyeA" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="12pt" fo:font-weight="bold" fo:color="#C4351F" fo:letter-spacing="0.11cm"/></style:style>
  <style:style style:name="pH2i" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="27pt" fo:font-weight="bold" fo:color="#1B1A17"/></style:style>
  <style:style style:name="pNumA" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="23pt" fo:font-weight="bold" fo:color="#C4351F"/></style:style>
  <style:style style:name="pNumW" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="23pt" fo:font-weight="bold" fo:color="#FFFFFF"/></style:style>
  <style:style style:name="pCardI" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="16pt" fo:font-weight="bold" fo:color="#1B1A17"/></style:style>
  <style:style style:name="pCardW" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="16pt" fo:font-weight="bold" fo:color="#FFFFFF"/></style:style>
  <style:style style:name="pDescS" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="11pt" fo:color="#6E6B64"/></style:style>
  <style:style style:name="pDescW" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="11pt" fo:color="#F5D9D2"/></style:style>
  <style:style style:name="pChev" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties style:font-name="Noto Sans" fo:font-size="20pt" fo:font-weight="bold" fo:color="#6E6B64"/></style:style>
  <style:style style:name="pFig" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="80pt" fo:font-weight="bold" fo:color="#C4351F"/></style:style>
  <style:style style:name="pH2w" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="24pt" fo:font-weight="bold" fo:color="#FFFFFF"/></style:style>
  <style:style style:name="pBodyS" style:family="paragraph"><style:paragraph-properties fo:text-align="start"/><style:text-properties style:font-name="Noto Sans" fo:font-size="14pt" fo:color="#9C9A93"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Master" style:page-layout-name="PL"/></office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Title" draw:style-name="dpDark" draw:master-page-name="Master">
    <draw:rect draw:style-name="gAccent" svg:width="0.6cm" svg:height="0.6cm" svg:x="1.6cm" svg:y="4.4cm"/>
    <draw:frame draw:style-name="gText" svg:width="25cm" svg:height="3cm" svg:x="1.5cm" svg:y="5.4cm"><draw:text-box><text:p text:style-name="pH1w">Turn one order into revenue</text:p></draw:text-box></draw:frame>
    <draw:rect draw:style-name="gAccent" svg:width="5cm" svg:height="0.08cm" svg:x="1.6cm" svg:y="9.1cm"/>
    <draw:frame draw:style-name="gText" svg:width="22cm" svg:height="1.6cm" svg:x="1.6cm" svg:y="9.5cm"><draw:text-box><text:p text:style-name="pSubL">A 15-second view of the plan, cart to cash</text:p></draw:text-box></draw:frame>
   </draw:page>
   <draw:page draw:name="Flow" draw:style-name="dpPaper" draw:master-page-name="Master">
    <draw:frame draw:style-name="gText" svg:width="20cm" svg:height="0.9cm" svg:x="1.6cm" svg:y="1.3cm"><draw:text-box><text:p text:style-name="pEyeA">HOW IT WORKS</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="25cm" svg:height="1.6cm" svg:x="1.6cm" svg:y="2.1cm"><draw:text-box><text:p text:style-name="pH2i">Four phases, one straight line to cash</text:p></draw:text-box></draw:frame>
    <draw:rect draw:style-name="gCardPanel" svg:width="5.5cm" svg:height="4.6cm" svg:x="2.1cm" svg:y="6.2cm"/>
    <draw:rect draw:style-name="gCardPanel" svg:width="5.5cm" svg:height="4.6cm" svg:x="8.2cm" svg:y="6.2cm"/>
    <draw:rect draw:style-name="gCardPanel" svg:width="5.5cm" svg:height="4.6cm" svg:x="14.3cm" svg:y="6.2cm"/>
    <draw:rect draw:style-name="gCardAccent" svg:width="5.5cm" svg:height="4.6cm" svg:x="20.4cm" svg:y="6.2cm"/>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.1cm" svg:x="2.5cm" svg:y="6.6cm"><draw:text-box><text:p text:style-name="pNumA">01</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="0.9cm" svg:x="2.5cm" svg:y="8.1cm"><draw:text-box><text:p text:style-name="pCardI">Checkout</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.6cm" svg:x="2.5cm" svg:y="9.1cm"><draw:text-box><text:p text:style-name="pDescS">Cart to a confirmed order</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.1cm" svg:x="8.6cm" svg:y="6.6cm"><draw:text-box><text:p text:style-name="pNumA">02</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="0.9cm" svg:x="8.6cm" svg:y="8.1cm"><draw:text-box><text:p text:style-name="pCardI">Payment</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.6cm" svg:x="8.6cm" svg:y="9.1cm"><draw:text-box><text:p text:style-name="pDescS">One authorization, captured</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.1cm" svg:x="14.7cm" svg:y="6.6cm"><draw:text-box><text:p text:style-name="pNumA">03</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="0.9cm" svg:x="14.7cm" svg:y="8.1cm"><draw:text-box><text:p text:style-name="pCardI">Fulfilment</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.6cm" svg:x="14.7cm" svg:y="9.1cm"><draw:text-box><text:p text:style-name="pDescS">Auto-routed to the warehouse</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.1cm" svg:x="20.8cm" svg:y="6.6cm"><draw:text-box><text:p text:style-name="pNumW">04</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="0.9cm" svg:x="20.8cm" svg:y="8.1cm"><draw:text-box><text:p text:style-name="pCardW">Settlement</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="4.7cm" svg:height="1.6cm" svg:x="20.8cm" svg:y="9.1cm"><draw:text-box><text:p text:style-name="pDescW">Reconciled and booked</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="0.9cm" svg:height="1cm" svg:x="7.45cm" svg:y="8cm"><draw:text-box><text:p text:style-name="pChev">&gt;</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="0.9cm" svg:height="1cm" svg:x="13.55cm" svg:y="8cm"><draw:text-box><text:p text:style-name="pChev">&gt;</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="0.9cm" svg:height="1cm" svg:x="19.65cm" svg:y="8cm"><draw:text-box><text:p text:style-name="pChev">&gt;</text:p></draw:text-box></draw:frame>
   </draw:page>
   <draw:page draw:name="Outcome" draw:style-name="dpDark" draw:master-page-name="Master">
    <draw:rect draw:style-name="gAccent" svg:width="5cm" svg:height="0.08cm" svg:x="1.6cm" svg:y="4.4cm"/>
    <draw:frame draw:style-name="gText" svg:width="24cm" svg:height="4cm" svg:x="1.6cm" svg:y="5cm"><draw:text-box><text:p text:style-name="pH1w">One straight line from cart to cash</text:p></draw:text-box></draw:frame>
    <draw:frame draw:style-name="gText" svg:width="22cm" svg:height="2.4cm" svg:x="1.6cm" svg:y="9cm"><draw:text-box><text:p text:style-name="pBodyS">Fewer handoffs, one automated settlement step, zero manual reconciliation.</text:p></draw:text-box></draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
