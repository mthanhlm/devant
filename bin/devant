#!/usr/bin/env python3
"""devant — the local intent + code graph CLI.

Thin entry point: the implementation lives in bin/devantlib/ (lazy per-subcommand
imports, dec-016). Hooks and tests that load THIS file as a module keep working via the
PEP 562 lazy re-export below — accessing evaluate_guard/evaluate_bash pulls only
devantlib.common + devantlib.guard, which is the guard hot-path guarantee.
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

# Search order matters: common/guard first so the Write/Edit/Bash hooks never import
# the heavy intent/drawio/graph modules just to reach the guard engine.
_LAZY_MODULES = ("common", "guard", "intent", "graphdb", "graphcmds", "drawio")


def __getattr__(name):
    import importlib
    for modname in _LAZY_MODULES:
        mod = importlib.import_module("devantlib." + modname)
        if hasattr(mod, name):
            val = getattr(mod, name)
            globals()[name] = val  # cache so repeat lookups skip this probe
            return val
    raise AttributeError("module 'devant' has no attribute %r" % name)


def main(argv=None):
    from devantlib.cli import main as _main
    return _main(argv)


if __name__ == "__main__":
    sys.exit(main())
